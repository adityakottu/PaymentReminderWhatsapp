# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=3000
# Set to true behind a reverse proxy / load balancer so req.ip is the client IP.
TRUST_PROXY=false

# ---------------------------------------------------------------- database
# better-sqlite3 (single server) or pg (required for multiple workers/instances)
DATABASE_CLIENT=better-sqlite3
SQLITE_FILENAME=./data/app.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/payment_reminders

# ---------------------------------------------------------------- auth
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# Used by `npm run seed` to create the first admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------- WhatsApp provider
# mock (development only) | meta_cloud (WhatsApp Business Platform Cloud API)
WHATSAPP_PROVIDER=mock
# Secrets – set via your secret manager in production, never in frontend code.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Secret – used to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_WEBHOOK_SECRET=
# Any random string; enter the same value in the Meta webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_REQUEST_TIMEOUT_MS=15000
# template (required for business-initiated reminders) | text (24h service window only)
WHATSAPP_SEND_MODE=template
WHATSAPP_TEMPLATE_NAME=payment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
# Body parameters {{1}}, {{2}}, ... of the approved template, in order.
WHATSAPP_TEMPLATE_PARAMS=customer_name,amount_due,due_date,account_id
# Mock only: simulate delivered/read callbacks so the dashboard shows them.
MOCK_SIMULATE_STATUS_CALLBACKS=true

# ---------------------------------------------------------------- queue / worker
# Total attempts per recipient for temporary failures (1st attempt + retries).
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=30000
RETRY_MAX_DELAY_MS=900000
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=120000
# Per worker process. Size this from your provider's CURRENT published throughput limits.
SEND_RATE_PER_SECOND=10
RECONCILE_WINDOW_MS=900000
# false on web nodes when running dedicated `npm run worker` processes.
RUN_WORKER_IN_PROCESS=true

# ---------------------------------------------------------------- reminders / upload
DUPLICATE_WINDOW_HOURS=24
MAX_UPLOAD_MB=5
MAX_ROWS=10000
INTERNATIONAL_NUMBERS_ENABLED=false
DEFAULT_COUNTRY_CODE=91

# ---------------------------------------------------------------- audit
AUDIT_CAPTURE_IP=true
